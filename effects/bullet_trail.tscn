[gd_scene load_steps=5 format=3 uid="uid://5rjiw13l2haa"]

[ext_resource type="Texture2D" uid="uid://wn8gxhwgjg5b" path="res://effects/bullet_trail_texture.tres" id="1_nxxdq"]

[sub_resource type="GDScript" id="GDScript_nxxdq"]
script/source = "extends Node3D

@export var target_pos = Vector3(0,0,0)
@export var speed = 75.0 #m/s
@export var tracer_length = 1.0

const MAX_LIFETIME_MS = 5000

@onready var spawn_time = Time.get_ticks_msec()
@onready var camera: Camera3D = get_viewport().get_camera_3d()

func _process(delta: float) -> void:
	var diff = target_pos - self.global_position
	var dist = diff.length()
	
	# Termination check
	if dist <= tracer_length or Time.get_ticks_msec() - spawn_time > MAX_LIFETIME_MS:
		self.queue_free()
		return

	# Trajectory calculation
	var dir = diff.normalized()
	var add = dir * speed * delta
	add = add.limit_length(dist)
	self.global_position += add

	# Dynamic roll alignment
	if camera and dist > 0.01:
		var cam_dir = (camera.global_position - self.global_position).normalized()
		
		# Prevent vector math crash if trail is pointing directly at the camera
		if abs(cam_dir.dot(dir)) < 0.99:
			self.look_at(target_pos, cam_dir)
		else:
			self.look_at(target_pos, Vector3.UP)
"

